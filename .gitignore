# 指定 Git 忽略的文件和目录（如虚拟环境、缓存、敏感配置等）。
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/
.env/

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Logs
*.log
logs/

# Database files
*.db
*.sqlite
*.sqlite3
*.db-journal

# Configuration files with secrets
.env
.env.*
!.env.example
config.local.*
secrets.*

# Data files (user-uploaded, generated output)
backend/data/uploads/
backend/data/templates/
backend/data/output/
!backend/data/.gitkeep

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-*

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Environment variables
*.env

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Backup files
*.bak
*.tmp
*.temp
*.swp

# Project specific
# 忽略前端构建产物（若后续使用 React/Vue 等）
frontend/node_modules/
frontend/dist/
frontend/.cache/

# 忽略大语言模型缓存（若使用本地模型）
models_cache/

vibeCodingTools/